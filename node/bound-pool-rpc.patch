+// Kobold Pool patch: names for submitblock's answer.
+static const char* accept_name(AcceptResult r) {
+    switch (r) {
+    case AcceptResult::Accepted: return "accepted";
+    case AcceptResult::Duplicate: return "duplicate";
+    case AcceptResult::BadProofOfWork: return "bad-proof-of-work";
+    case AcceptResult::UnknownParent: return "unknown-parent";
+    case AcceptResult::InvalidParent: return "invalid-parent";
+    case AcceptResult::BadDifficulty: return "bad-difficulty";
+    case AcceptResult::TimeTooOld: return "time-too-old";
+    case AcceptResult::TimeTooNew: return "time-too-new";
+    }
+    return "unknown";
+}
+
+static const char* connect_name(ConnectResult r) {
+    switch (r) {
+    case ConnectResult::Ok: return "ok";
+    case ConnectResult::BadBlock: return "bad-block";
+    case ConnectResult::BadCoinbaseHeight: return "bad-coinbase-height";
+    case ConnectResult::BadInputs: return "bad-inputs";
+    case ConnectResult::DuplicateOutput: return "duplicate-output";
+    case ConnectResult::CoinbaseTooLarge: return "coinbase-too-large";
+    }
+    return "unknown";
+}

+
+// Kobold Pool patch: a pool's round trip. getblocktemplate's header and coinbase, the coinbase memo
+// swapped for the pool's own extra nonce, the merkle root recomputed, the nonce found, then the whole
+// block through submitblock; with and without a mempool transaction.
+TEST_F(NodeRpcTest, PoolTemplateAndSubmitBlock) {
+    const KeyPair alice = test_key("alice");
+    const std::string pool_addr = encode_address(test_key("pool").public_key(), params.address_version);
+    EXPECT_EQ(error_code("getblocktemplate", {"nonsense"}), rpc_error::kInvalidAddressOrKey);
+    EXPECT_EQ(error_code("submitblock", {"zz"}), rpc_error::kDeserialization);
+    EXPECT_EQ(error_code("submitblock", {"00"}), rpc_error::kDeserialization);
+
+    // Builds and mines the block a pool would, from a template, with `memo` as the extra nonce.
+    const auto pool_block = [&](const json& tmpl, const std::string& memo) {
+        Bytes coinbase = from_hex(tmpl["coinbase"].get<std::string>()).value();
+        EXPECT_EQ(coinbase.back(), 0);
+        EXPECT_EQ(coinbase[coinbase.size() - 9], 8);  // var_bytes: an 8-byte memo, last
+        coinbase.resize(coinbase.size() - 9);
+        coinbase.push_back(static_cast<std::uint8_t>(memo.size()));
+        coinbase.insert(coinbase.end(), memo.begin(), memo.end());
+        Block block;
+        block.header = BlockHeader::deserialize(from_hex(tmpl["header"].get<std::string>()).value());
+        block.txs.push_back(Transaction::deserialize(coinbase));
+        for (const json& tx : tmpl["transactions"]) block.txs.push_back(Transaction::deserialize(from_hex(tx["data"].get<std::string>()).value()));
+        std::vector<uint256> leaves;
+        for (const Transaction& tx : block.txs) leaves.push_back(tx.wtxid());
+        block.header.merkle_root = merkle_root(leaves);
+        block.header = mine(block.header, params).value();
+        return block;
+    };
+
+    json tmpl = call("getblocktemplate", {pool_addr});
+    EXPECT_EQ(tmpl["height"], 1);
+    EXPECT_EQ(tmpl["previousblockhash"], chain.tip().hash.to_hex());
+    EXPECT_EQ(tmpl["coinbasevalue"], block_subsidy(1, params));
+    EXPECT_EQ(tmpl["pow_lines"], params.pow_lines);
+    EXPECT_EQ(tmpl["bits"], "207fffff");
+    EXPECT_TRUE(tmpl["transactions"].empty());
+    EXPECT_EQ(tmpl["initial_sync"], false);
+    Block block = pool_block(tmpl, "KoboldPool-s1-0001");
+    json r = call("submitblock", {to_hex(block.serialize())});
+    EXPECT_EQ(r["accepted"], true);
+    EXPECT_EQ(r["tip"], true);
+    EXPECT_EQ(r["height"], 1);
+    EXPECT_EQ(r["hash"], block.hash().to_hex());
+    EXPECT_EQ(chain.tip().hash, block.hash());
+    EXPECT_EQ(chain.block_at(1).txs[0].outputs[0].recipient, test_key("pool").public_key());
+    r = call("submitblock", {to_hex(block.serialize())});  // again
+    EXPECT_EQ(r["accepted"], false);
+    EXPECT_EQ(r["header"], "duplicate");
+
+    // A block whose coinbase pays more than allowed is refused, with the reason.
+    tmpl = call("getblocktemplate", {pool_addr});
+    Transaction greedy = Transaction::deserialize(from_hex(tmpl["coinbase"].get<std::string>()).value());
+    greedy.outputs[0].amount += 1;
+    json bad = tmpl;
+    bad["coinbase"] = to_hex(greedy.serialize());
+    r = call("submitblock", {to_hex(pool_block(bad, "x").serialize())});
+    EXPECT_EQ(r["accepted"], false);
+    EXPECT_EQ(r["body"], "coinbase-too-large");
+    EXPECT_EQ(chain.height(), 1);
+
+    // With a transaction waiting: alice's mature coinbase, spent to bob.
+    const std::string alice_addr = encode_address(alice.public_key(), params.address_version);
+    call("generatetoaddress", {101, alice_addr});
+    const Transaction coinbase = chain.block_at(2).txs[0];
+    ASSERT_EQ(coinbase.outputs[0].recipient, alice.public_key());
+    Transaction pay;
+    pay.inputs.push_back(OutPoint{coinbase.txid(), 0});
+    pay.outputs.push_back(TxOut{coinbase.outputs[0].amount - 1000, test_key("bob").public_key()});
+    sign_all_inputs(pay, alice);
+    call("sendrawtransaction", {to_hex(pay.serialize())});
+    tmpl = call("getblocktemplate", {pool_addr});
+    ASSERT_EQ(tmpl["transactions"].size(), 1u);
+    EXPECT_EQ(tmpl["transactions"][0]["txid"], pay.txid().to_hex());
+    EXPECT_EQ(tmpl["transactions"][0]["wtxid"], pay.wtxid().to_hex());
+    EXPECT_EQ(tmpl["coinbasevalue"], block_subsidy(chain.height() + 1, params) + 1000);
+    block = pool_block(tmpl, "KoboldPool-s2-0002");
+    r = call("submitblock", {to_hex(block.serialize())});
+    EXPECT_EQ(r["accepted"], true);
+    EXPECT_EQ(r["tip"], true);
+    EXPECT_EQ(mempool.size(), 0u);
+    EXPECT_EQ(chain.tip().hash, block.hash());
+}

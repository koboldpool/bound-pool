[Unit]
Description=BOUND pool payouts (PPLNS credit + pay balances >= 1 BOUND)
After=bound-node.service
Requires=bound-node.service

[Service]
Type=oneshot
User=kobold
Group=kobold
WorkingDirectory=/srv/kobold/coins/bound
# The wallet passphrase stays in .wallet-pass (mode 600, owner kobold); payout.py reads it with --passphrase-file.
ExecStart=/usr/bin/python3 /srv/kobold/coins/bound/payout.py --network mainnet --data /srv/kobold/coins/bound/pool-data --cookie /srv/kobold/coins/bound/node/.cookie --passphrase-file /srv/kobold/coins/bound/.wallet-pass --min 1 --pay
